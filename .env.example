# ============================================================================
# RecallOps Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Groq LLM Configuration (REQUIRED unless MOCK_MODE=true)
# Get your API key from https://console.groq.com/
# ----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ----------------------------------------------------------------------------
# Hindsight Memory Configuration (REQUIRED unless MOCK_MODE=true)
# Configure per Hindsight documentation (Cloud or self-hosted)
# ----------------------------------------------------------------------------
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.ai
HINDSIGHT_BANK_ID=your_bank_id_here

# ----------------------------------------------------------------------------
# Backend Configuration
# ----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# Frontend Configuration
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8501

# ----------------------------------------------------------------------------
# PostgreSQL Database (REQUIRED - no SQLite fallback)
# Format: postgresql://user:password@host:port/database
# Example: postgresql://recallops:password@localhost:5432/recallops
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://recallops:password@localhost:5432/recallops

# ----------------------------------------------------------------------------
# Mock Mode - EXPLICITLY enable for development without external services
# When true: uses mock implementations for Groq and Hindsight
# When false (default): requires real Groq and Hindsight credentials
# ----------------------------------------------------------------------------
MOCK_MODE=false

# ----------------------------------------------------------------------------
# Application Environment
# ----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO